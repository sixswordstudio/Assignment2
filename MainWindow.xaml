    <!-- 
    Author: Amy Park 
    Date: 2026-Nov-1  
    Purpose: This is the main window of the Challenge Tracker application. It serves as the primary interface for users to interact with the application, allowing them to view and manage their challenges. The window is designed to be user-friendly and visually appealing, providing a seamless experience for tracking progress and achievements.
    Assignment: Assignment 2 - Challenge Tracker Application 
    -->
<!--#endregion-->

<!--#region Requirement 01 -->
    <!--
    Requirement 01: Meaningful, centred, resizable window
    Technical Solution: A 2* width column takes twice as much space as *, so that the left-hand column is always smaller than the right.
    User Narrative: As a gamer, I want the area where I can see my challenges to be easily readable and resizeable so that I can read them comfortably while playing.
    Business Value: When the text is difficult to read, the user risks losing their match objectives while trying to read the challenge. This would lower trust in, and then interest in, the challenge app. To prevent customer churn, it's in our interest to ensure the window maintains proportions and readability even while being resized. 
    -->
<!--#endregion-->
<Window x:Class="Assignment2.Challenges"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Assignment2"
        mc:Ignorable="d"
        Title="Challenge Tracker" Height="450" Width="800" 
        WindowStartupLocation="CenterScreen">
    <Grid>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="2*"/> 
        </Grid.ColumnDefinitions>

        <StackPanel x:Name="rulesPanel" Grid.Row="1" Grid.Column="0">
            <TextBlock FontSize="25"
                       Margin="10"
                       />
            <TextBlock FontSize="25"
                       Margin="10"
                       />
            <TextBlock FontSize="25"
                       Margin="10"
                       />
        </StackPanel>

    </Grid>
</Window>
